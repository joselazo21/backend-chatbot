POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=replace-with-a-local-password
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# Deja la URL vacía hasta conocer el endpoint exacto del servicio LLM.
LLM_CHAT_URL=
LLM_MODEL=
LLM_API_TOKEN=
LLM_TIMEOUT_SECONDS=60

# Endpoint OpenAI-compatible de embeddings (/v1/embeddings).
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_API_TOKEN=
EMBEDDING_TIMEOUT_SECONDS=60

# Transcripción de audio (Speaches / API OpenAI-compatible, /v1/audio/transcriptions).
# Déjalo vacío para desactivar los mensajes de voz.
WHISPER_URL=
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_API_TOKEN=
WHISPER_LANGUAGE=
WHISPER_TIMEOUT_SECONDS=120
WHISPER_MAX_AUDIO_BYTES=5242880

# Para el perfil opcional del puente Baileys (una cuenta por instancia).
DJANGO_PUBLIC_HOST=localhost
BAILEYS_CHANNEL_ID=
BAILEYS_CHANNEL_SECRET=

# Añade TELEGRAM_BOT_TOKEN_<CLIENTE> para cada bot Telegram registrado.
